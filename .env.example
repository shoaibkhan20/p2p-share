# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── TURN server (optional but recommended for production) ────────────────────
#
# Without a TURN server, ~10-15% of connections behind symmetric NAT or
# restrictive firewalls will fail. Free options:
#
#   Metered.ca free tier  → https://www.metered.ca/tools/openrelay/
#   Self-hosted coturn    → https://github.com/coturn/coturn
#
# Prefix MUST be NEXT_PUBLIC_ so Next.js exposes these to the browser bundle.

NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
